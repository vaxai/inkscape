#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Run an Inkscape test (or any command) under Linux perf, then generate a
# FlameGraph SVG.  Configured by CMake (PerformanceTest.cmake).
#
# Usage:
#   run_perf_test.sh --test-name NAME --report-dir DIR [options] -- COMMAND [args...]
#
# Options:
#   --test-name NAME           Logical test name (used in output filenames)
#   --report-dir DIR           Directory for perf data and flame graphs
#   --iterations N             Repeat COMMAND N times inside one perf session (default: @PERF_TEST_ITERATIONS@)
#   --max-time SECONDS         Fail if wall time exceeds this (default: @PERF_TEST_MAX_TIME@)
#   --call-stack-mode MODE     kernel | userspace | both (default: @PERF_TEST_CALL_STACK_MODE@)
#   --workdir DIR              Working directory for COMMAND
#   --perf PATH                perf executable (default: @PERF_EXECUTABLE@)
#   --flamegraph PATH          flamegraph.pl (default: @FLAMEGRAPH_SCRIPT@)
#   --stackcollapse PATH       stackcollapse-perf.pl (default: @STACKCOLLAPSE_PERF_SCRIPT@)
#   --help                     Show this help
#
# Output files (never overwritten between runs; timestamp + pid suffix):
#   <report-dir>/<test-name>-<timestamp>-<pid>.perf.data
#   <report-dir>/<test-name>-<timestamp>-<pid>.perf.script
#   <report-dir>/<test-name>-<timestamp>-<pid>.folded
#   <report-dir>/<test-name>-<timestamp>-<pid>.svg          <-- flame graph
#   <report-dir>/<test-name>-<timestamp>-<pid>.meta.txt     <-- run metadata

set -euo pipefail

PERF_BIN="${PERF_BIN:-@PERF_EXECUTABLE@}"
FLAMEGRAPH_PL="${FLAMEGRAPH_PL:-@FLAMEGRAPH_SCRIPT@}"
STACKCOLLAPSE_PL="${STACKCOLLAPSE_PL:-@STACKCOLLAPSE_PERF_SCRIPT@}"
DEFAULT_ITERATIONS="@PERF_TEST_ITERATIONS@"
DEFAULT_MAX_TIME="@PERF_TEST_MAX_TIME@"
DEFAULT_CALL_STACK_MODE="@PERF_TEST_CALL_STACK_MODE@"

TEST_NAME=""
REPORT_DIR=""
ITERATIONS="${DEFAULT_ITERATIONS}"
MAX_TIME="${DEFAULT_MAX_TIME}"
CALL_STACK_MODE="${DEFAULT_CALL_STACK_MODE}"
WORKDIR=""
CMD=()

usage() {
    sed -n '2,30p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

die() {
    echo "run_perf_test.sh: error: $*" >&2
    exit 1
}

# --- argument parsing --------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --test-name)       TEST_NAME="$2"; shift 2 ;;
        --report-dir)      REPORT_DIR="$2"; shift 2 ;;
        --iterations)      ITERATIONS="$2"; shift 2 ;;
        --max-time)        MAX_TIME="$2"; shift 2 ;;
        --call-stack-mode) CALL_STACK_MODE="$2"; shift 2 ;;
        --workdir)         WORKDIR="$2"; shift 2 ;;
        --perf)            PERF_BIN="$2"; shift 2 ;;
        --flamegraph)      FLAMEGRAPH_PL="$2"; shift 2 ;;
        --stackcollapse)   STACKCOLLAPSE_PL="$2"; shift 2 ;;
        --help|-h)         usage 0 ;;
        --)                shift; CMD=("$@"); break ;;
        *)                 die "unknown option: $1 (use -- before the command)" ;;
    esac
done

[[ -n "$TEST_NAME" ]]  || die "--test-name is required"
[[ -n "$REPORT_DIR" ]] || die "--report-dir is required"
[[ ${#CMD[@]} -gt 0 ]] || die "COMMAND is required after --"
[[ "$ITERATIONS" =~ ^[1-9][0-9]*$ ]] || die "--iterations must be a positive integer (got: $ITERATIONS)"
[[ "$MAX_TIME" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "--max-time must be a positive number (got: $MAX_TIME)"

case "$CALL_STACK_MODE" in
    kernel|userspace|both) ;;
    *) die "--call-stack-mode must be kernel, userspace, or both (got: $CALL_STACK_MODE)" ;;
esac

command -v "$PERF_BIN" >/dev/null 2>&1 || die "perf not found: $PERF_BIN"
[[ -x "$FLAMEGRAPH_PL" || -f "$FLAMEGRAPH_PL" ]] || die "flamegraph.pl not found: $FLAMEGRAPH_PL"
[[ -x "$STACKCOLLAPSE_PL" || -f "$STACKCOLLAPSE_PL" ]] || die "stackcollapse-perf.pl not found: $STACKCOLLAPSE_PL"

mkdir -p "$REPORT_DIR"

# Unique suffix so multiple reports of the same test never overwrite each other.
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_ID="${TIMESTAMP}-$$"
SAFE_NAME="${TEST_NAME//\//_}"

PERF_DATA="${REPORT_DIR}/${SAFE_NAME}-${RUN_ID}.perf.data"
PERF_SCRIPT_OUT="${REPORT_DIR}/${SAFE_NAME}-${RUN_ID}.perf.script"
FOLDED_OUT="${REPORT_DIR}/${SAFE_NAME}-${RUN_ID}.folded"
SVG_OUT="${REPORT_DIR}/${SAFE_NAME}-${RUN_ID}.svg"
META_OUT="${REPORT_DIR}/${SAFE_NAME}-${RUN_ID}.meta.txt"
LATEST_LINK="${REPORT_DIR}/${SAFE_NAME}-latest.svg"

# perf event / call-graph selection based on mode
PERF_EVENT_ARGS=()
case "$CALL_STACK_MODE" in
    kernel)
        PERF_EVENT_ARGS=(-e cycles:k --call-graph dwarf)
        ;;
    userspace)
        PERF_EVENT_ARGS=(-e cycles:u --call-graph dwarf)
        ;;
    both)
        PERF_EVENT_ARGS=(-e cycles --call-graph dwarf)
        ;;
esac

# Write a small payload script so perf record can invoke it as a child process
# (functions defined in this shell are not visible inside `perf record -- ...`).
PAYLOAD_SCRIPT="$(mktemp "${TMPDIR:-/tmp}/inkscape-perf-payload.XXXXXX.sh")"
cleanup_payload() { rm -f "$PAYLOAD_SCRIPT"; }
trap cleanup_payload EXIT

{
    echo '#!/usr/bin/env bash'
    echo 'set -euo pipefail'
    echo "ITERATIONS=${ITERATIONS}"
    printf 'WORKDIR=%q\n' "$WORKDIR"
    echo 'CMD=('
    for arg in "${CMD[@]}"; do
        printf ' %q' "$arg"
    done
    echo
    echo ')'
    cat <<'PAYLOAD_BODY'
for ((i = 1; i <= ITERATIONS; i++)); do
    if [[ -n "${WORKDIR}" ]]; then
        (cd "${WORKDIR}" && "${CMD[@]}")
    else
        "${CMD[@]}"
    fi
done
PAYLOAD_BODY
} >"$PAYLOAD_SCRIPT"
chmod +x "$PAYLOAD_SCRIPT"

START_EPOCH="$(date +%s)"

echo "=== Performance test: ${TEST_NAME} ==="
echo "  iterations:      ${ITERATIONS}"
echo "  max time (s):    ${MAX_TIME}"
echo "  call stacks:     ${CALL_STACK_MODE}"
echo "  report dir:      ${REPORT_DIR}"
echo "  run id:          ${RUN_ID}"
echo "  command:         ${CMD[*]}"
echo

# Prefer GNU timeout when present; fall back to running without it.
TIMEOUT_CMD=()
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(timeout --signal=TERM "${MAX_TIME}")
fi

# Record under perf.  Iterations share a single perf session for denser samples.
set +e
PERF_LOG="$(mktemp "${TMPDIR:-/tmp}/inkscape-perf-record.XXXXXX.log")"
"${TIMEOUT_CMD[@]}" \
    "$PERF_BIN" record \
        "${PERF_EVENT_ARGS[@]}" \
        --output="$PERF_DATA" \
        -- \
        bash "$PAYLOAD_SCRIPT" >"$PERF_LOG" 2>&1 || PERF_RC=$?
set -e
PERF_RC="${PERF_RC:-0}"
if [[ -s "$PERF_LOG" ]]; then
    cat "$PERF_LOG"
fi
rm -f "$PERF_LOG"

if [[ "$PERF_RC" -ne 0 ]] && grep -q "perf_event_paranoid" <<<"$(dmesg 2>/dev/null || true)"; then
    :
fi
# Surface a helpful hint when perf is blocked by kernel permissions.
if [[ "$PERF_RC" -ne 0 ]]; then
    if [[ -r /proc/sys/kernel/perf_event_paranoid ]]; then
        _paranoid="$(cat /proc/sys/kernel/perf_event_paranoid 2>/dev/null || echo '?')"
        if [[ "${_paranoid}" != "-1" && "${_paranoid}" -gt 1 ]]; then
            echo "run_perf_test.sh: hint: kernel.perf_event_paranoid=${_paranoid}; try:" >&2
            echo "  sudo sysctl -w kernel.perf_event_paranoid=-1" >&2
        fi
    fi
fi

END_EPOCH="$(date +%s)"
ELAPSED=$((END_EPOCH - START_EPOCH))

# timeout returns 124 on expiry
if [[ "$PERF_RC" -eq 124 ]]; then
    echo "run_perf_test.sh: FAIL: exceeded maximum time of ${MAX_TIME}s (elapsed ~${ELAPSED}s)" >&2
    {
        echo "status=TIMEOUT"
        echo "test_name=${TEST_NAME}"
        echo "run_id=${RUN_ID}"
        echo "iterations=${ITERATIONS}"
        echo "max_time=${MAX_TIME}"
        echo "elapsed_seconds=${ELAPSED}"
        echo "call_stack_mode=${CALL_STACK_MODE}"
        echo "command=${CMD[*]}"
        echo "perf_data=${PERF_DATA}"
    } >"$META_OUT"
    exit 1
fi

if [[ "$PERF_RC" -ne 0 ]]; then
    echo "run_perf_test.sh: FAIL: perf record / command exited with ${PERF_RC}" >&2
    {
        echo "status=FAIL"
        echo "exit_code=${PERF_RC}"
        echo "test_name=${TEST_NAME}"
        echo "run_id=${RUN_ID}"
        echo "iterations=${ITERATIONS}"
        echo "elapsed_seconds=${ELAPSED}"
        echo "call_stack_mode=${CALL_STACK_MODE}"
        echo "command=${CMD[*]}"
        echo "perf_data=${PERF_DATA}"
    } >"$META_OUT"
    exit "$PERF_RC"
fi

# Enforce max-time even if timeout didn't fire (e.g. timeout unavailable)
if (( ELAPSED > ${MAX_TIME%.*} )); then
    echo "run_perf_test.sh: FAIL: elapsed ${ELAPSED}s exceeds max time ${MAX_TIME}s" >&2
    {
        echo "status=TIMEOUT"
        echo "test_name=${TEST_NAME}"
        echo "run_id=${RUN_ID}"
        echo "iterations=${ITERATIONS}"
        echo "max_time=${MAX_TIME}"
        echo "elapsed_seconds=${ELAPSED}"
        echo "call_stack_mode=${CALL_STACK_MODE}"
        echo "command=${CMD[*]}"
        echo "perf_data=${PERF_DATA}"
    } >"$META_OUT"
    exit 1
fi

# Generate flame graph from perf data
echo "Generating flame graph..."
"$PERF_BIN" script --input="$PERF_DATA" >"$PERF_SCRIPT_OUT"
perl "$STACKCOLLAPSE_PL" "$PERF_SCRIPT_OUT" >"$FOLDED_OUT"
perl "$FLAMEGRAPH_PL" \
    --title "Inkscape perf: ${TEST_NAME} (${RUN_ID})" \
    --subtitle "iterations=${ITERATIONS} mode=${CALL_STACK_MODE} elapsed=${ELAPSED}s" \
    "$FOLDED_OUT" >"$SVG_OUT"

# Convenience symlink to the most recent SVG for this test name
ln -sfn "$(basename "$SVG_OUT")" "$LATEST_LINK"

{
    echo "status=OK"
    echo "test_name=${TEST_NAME}"
    echo "run_id=${RUN_ID}"
    echo "iterations=${ITERATIONS}"
    echo "max_time=${MAX_TIME}"
    echo "elapsed_seconds=${ELAPSED}"
    echo "call_stack_mode=${CALL_STACK_MODE}"
    echo "command=${CMD[*]}"
    echo "workdir=${WORKDIR}"
    echo "perf_data=${PERF_DATA}"
    echo "perf_script=${PERF_SCRIPT_OUT}"
    echo "folded=${FOLDED_OUT}"
    echo "flamegraph_svg=${SVG_OUT}"
    echo "latest_symlink=${LATEST_LINK}"
} >"$META_OUT"

echo
echo "=== Performance test OK: ${TEST_NAME} ==="
echo "  elapsed:         ${ELAPSED}s (limit ${MAX_TIME}s)"
echo "  perf data:       ${PERF_DATA}"
echo "  flame graph:     ${SVG_OUT}"
echo "  latest symlink:  ${LATEST_LINK}"
echo "  metadata:        ${META_OUT}"

exit 0
